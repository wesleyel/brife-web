# Cloudflare Pages 的 _headers。由 scripts/copy-cf-assets.mjs 拷进 public/。
# 语法：https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Quartz 的 css/js 文件名里带内容哈希，内容一变文件名就变，可以永久缓存
/index-*.css
  Cache-Control: public, max-age=31536000, immutable

/component-*.css
  Cache-Control: public, max-age=31536000, immutable

/prescript-*.js
  Cache-Control: public, max-age=31536000, immutable

/postscript-*.js
  Cache-Control: public, max-age=31536000, immutable

/static/*
  Cache-Control: public, max-age=31536000, immutable

# 题图这类附件不带哈希，缓存一天，改图后最迟第二天生效
/exercises/attachments/*
  Cache-Control: public, max-age=86400
